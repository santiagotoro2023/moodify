{
  "name": "moodify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @moodify/backend & npm run dev -w @moodify/frontend",
    "build": "npm run build -w @moodify/frontend",
    "check": "tsc --noEmit -p apps/backend && tsc --noEmit -p apps/frontend",
    "test": "npm run test -w @moodify/backend"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
